# Copy to .env in this directory — docker compose reads `.env` for ${...}
# interpolation, which is how the build args below reach the Dockerfile.
#
#   cp env.docker.sample .env
#
# (.env* is gitignored, which is why this sample has no leading dot.)

# ── Build time AND runtime ───────────────────────────────────────────────────
# Inlined into the client bundle by `next build`, so these must be present when
# the image is built — supplying them only at `docker run` is too late. Both are
# public by design: the anon/publishable key is meant to reach the browser and is
# constrained by RLS. From Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=your-anon-or-publishable-key

# ── Runtime only — real secret ───────────────────────────────────────────────
# Bypasses RLS. Required for admin user management (create/invite/delete users)
# and for reading the stored Gemini key on behalf of a non-admin editor.
# Never expose it to the browser and never pass it as a Docker build arg.
# From Supabase → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Optional ─────────────────────────────────────────────────────────────────
# Fallback Gemini key used only when no key is stored in app_settings. Leave
# blank to rely solely on the key an admin sets in Settings.
GEMINI_API_KEY=

# No port variable: the app is fixed on 5174 in the Dockerfile, docker-compose.yml
# and the npm scripts. To move it, change those three rather than adding one here —
# Next cannot read PORT from an env file at all (the HTTP server binds before env
# files load), so a PORT entry here would silently do nothing.
