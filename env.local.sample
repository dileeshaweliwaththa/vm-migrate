# Copy this file to .env.local and fill in your Supabase project values.
#   cp env.local.sample .env.local

# From the Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=your-anon-or-publishable-key

# Required for admin user management (Phase 2): creating/inviting users and
# deleting them go through the service-role client (lib/supabase/service.ts).
# Also used by any route with no cookie session.
# From Supabase -> Project Settings -> API -> service_role key (secret!).
# NEVER prefix this with NEXT_PUBLIC_ and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
